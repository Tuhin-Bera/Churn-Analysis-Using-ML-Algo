# ==============================================================================
# .env.example — Template for environment configuration
# ==============================================================================
# Copy this file to .env and fill in real values.
# The .env file is listed in .gitignore and must NEVER be committed to git.
#
# Usage:
#   cp .env.example .env
#   Then edit .env with real credentials.
# ==============================================================================

# --- PostgreSQL Database (optional; app falls back to SQLite if not set) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=telecom_churn
PG_USER=postgres
PG_PASSWORD=your_password_here

# Alternatively, set a full DATABASE_URL (overrides individual PG_* vars above)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/telecom_churn

# --- Streamlit Server Settings ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# --- App-level configuration ---
# Set to 'production' for deployed environments, 'development' locally
APP_ENV=development

# --- Model & Pipeline Settings ---
# Path to CSV dataset (relative to project root)
DATA_PATH=data/WA_Fn-UseC_-Telco-Customer-Churn.csv

# Path to outputs directory where models and predictions are stored
OUTPUTS_DIR=outputs

